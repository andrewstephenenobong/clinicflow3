# Port for the Express server to listen on
PORT=8000

# PostgreSQL connection URLs (Supabase or local Postgres)
# DATABASE_URL is used for query execution (often pooled, e.g. transaction mode)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinicflow?schema=public"
# DIRECT_URL is used for schema migrations (direct connection to the database)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/clinicflow?schema=public"

# Authentication Settings
# A secure random secret key for signing JWTs
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Client CORS Settings (optional, falls back to reflecting origin in dev)
FRONTEND_URL="http://localhost:5000"

# Node Environment
NODE_ENV="development"
